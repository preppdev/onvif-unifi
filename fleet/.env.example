# Copy to .env and fill in. Used by docker-compose.
FLEET_ADMIN_PASSWORD=choose-a-strong-dashboard-password
FLEET_ENROLL_KEY=shared-secret-for-registering-new-boxes
# Optional: seconds without a heartbeat before a box shows offline.
FLEET_OFFLINE_AFTER=180

# One-line provisioning: `curl -fsSL <fleet>/enroll/$FLEET_PROVISION_TOKEN | sudo bash`
# Serves a bootstrap script with these baked in (token-gated). Leave token blank
# to disable the endpoint.
FLEET_PROVISION_TOKEN=long-random-url-secret
FLEET_TAILSCALE_AUTHKEY=tskey-auth-REUSABLE-...
FLEET_PUBLIC_URL=http://fleet:8080
